<!-- heading in head.ejs -->
<%- include('partials/head') %> 
  </head>

  <body class="bg-gray-100 font-sans">
    <!-- navbar in nav.ejs  -->
    <%- include('partials/nav') %>

    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-xl">
      <h2 class="text-2xl text-gray-800 font-bold text-center mb-6">
        here are our registered homes:
      </h2>

      <ul class="space-y-3">
        <% registeredHome.forEach(home=> { %>
          <li class="border border-gray-200 rounded-lg p-4 bg-gray-50 text-gray-700 shadow-sm">
            <span class="font-semibold text-gray-900">
              <%= home.houseName %>
            </span>
          </li>
          <% }) %>

            <% if (registeredHome.length===0) { %>
              <li class="text-center text-gray-500 italic">
                No homes registered yet.
              </li>
              <% } %>
      </ul>
    </main>
  </body>



  </html>