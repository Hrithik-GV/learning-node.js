<%- include('../partials/head') %>
  </head>


  <body class="bg-gray-100 font-sans">
    <%- include('../partials/nav') %>

      <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-xl">
        <h2 class="text-2xl text-gray-800 font-bold text-center mb-6">
          <header>
            <p>
              login to airbnb
            </p>
          </header>
        </h2>

        <form action="/login" method="POST" class="flex flex-col gap-4">
          <%- include('../partials/error') %>


          <input type="text" name="email" placeholder="Enter your email" value="<%= oldInput.email? oldInput.email:''%>"
            class="border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400" 
            required/>

          <input type="password"  name="password" placeholder="Enter your password"
            class="border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"
            required />


          <input type="submit" class="bg-red-500 hover:bg-red-600 text-white px-4
          py-2 rounded transition duration-300 self-center w-full max-w-sm"/>

          
        </form>
      </main>
  </body>

  </html>